# --- Database ---------------------------------------------------------------
# Neon Postgres connection string (Dashboard → Connection Details → pooled
# connection). For local-only dev without Neon, `npx prisma dev` also works.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
APP_BASE_URL="http://localhost:3000"

# --- Transactional email (Resend) --------------------------------------------
# Leave EMAIL_PROVIDER_API_KEY empty in development: emails are logged to the
# console and to the EmailDeliveryLog table instead of being sent.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="Shadow Fight Arena <noreply@example.com>"

# --- Initial Super Admin bootstrap --------------------------------------------
# One-time setup token used by the `npm run create-super-admin` script to
# create the first Super Admin account. Rotate/remove after first use.
SUPER_ADMIN_SETUP_TOKEN=""
